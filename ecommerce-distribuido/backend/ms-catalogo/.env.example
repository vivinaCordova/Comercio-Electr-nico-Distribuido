# Copy to .env and replace both placeholder passwords before starting the stack.
POSTGRES_DB=catalogo_db
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD

RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_LONG_PASSWORD

# Host ports chosen to avoid the existing Odoo PostgreSQL and RabbitMQ ports.
POSTGRES_HOST_PORT=5433
RABBITMQ_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673

# Port 8081 is already occupied on this host; the container still listens on 8081.
CATALOGO_HOST_PORT=8082
